# CockroachDB Cloud connection string. Get this from the CockroachDB Cloud
# console (Connect -> Connection string) -- it starts with "postgresql://",
# but change the scheme to "cockroachdb://" as shown below. Plain SQLAlchemy
# with the generic postgres dialect can't parse CockroachDB's version string
# ("CockroachDB CCL v26.2.5 ..." vs "PostgreSQL 14.2 ..."), so this project
# uses the sqlalchemy-cockroachdb dialect, selected via the URL scheme.
#
# sslrootcert points at the CA cert committed in this repo (backend/certs/root.crt),
# so the path is the same whether you run via `uvicorn` locally, Docker, or Render.
DATABASE_URL=cockroachdb://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full&sslrootcert=certs/root.crt

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
